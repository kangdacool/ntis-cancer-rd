# ---------------------------------------------------------------------------
# Data — never commit. The NTIS census is ~550 MB and is rebuilt by
# tools/ntis_api_census.py; see README "Quick start".
# ---------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep

*.csv
!lexicon/*.csv

*.xls
*.xlsx
!data/epi/*.xlsx

*.RData
*.rda
*.rds

# ---------------------------------------------------------------------------
# Analysis outputs — regenerated by R/run_all.R
# ---------------------------------------------------------------------------
output/tables/*
output/figures/*
!output/**/.gitkeep

# ---------------------------------------------------------------------------
# Secrets. The NTIS API key is read from $NTIS_API_KEY and is never written
# to a file by any script in this repository.
# ---------------------------------------------------------------------------
.env
.env.*
*.key
*_secret*
SESSION_LOG.md

# ---------------------------------------------------------------------------
# R / Python / editor / OS cruft
# ---------------------------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
Rplots.pdf
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
